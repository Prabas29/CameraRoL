# ============================================================================
# Rol — environment variables
# Salin file ini jadi `.env.local`, lalu isi nilainya. `.env.local` sudah
# di-gitignore, jangan pernah di-commit.
#
# Semua nilai di bawah ada di Supabase Dashboard:
#   Project Settings → API
# ============================================================================

# URL project Supabase, bentuknya https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Key "anon / public". Aman terekspos ke browser — dipakai HANYA untuk auth
# host (magic link) dan query host yang sudah dijaga RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Key "service_role". RAHASIA — melewati semua RLS.
# Hanya dipakai di server (route handler), tidak pernah dikirim ke browser.
# Jangan pernah menamainya dengan awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL aplikasi. Dipakai untuk membangun link undangan + QR code.
#   dev    : http://localhost:3000
#   vercel : JANGAN di-set. Aplikasi mendeteksi sendiri domain produksi maupun
#            preview, jadi QR di tiap deployment mengarah ke tempat yang benar.
#            Set hanya kalau kamu memakai custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
